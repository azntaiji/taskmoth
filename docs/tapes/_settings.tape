# Shared settings for every recording (sourced by the other tapes).
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1060
Set Height 660
Set Padding 16
Set Margin 0
Set WindowBar ""
Set TypingSpeed 60ms
Set Framerate 30
Set Theme { "name": "taskmoth", "background": "#22212c", "foreground": "#f8f8f2", "cursor": "#f8f8f2", "selection": "#9282f7", "black": "#22212c", "red": "#ff9580", "green": "#8aff80", "yellow": "#ffff80", "blue": "#9580ff", "magenta": "#ff80bf", "cyan": "#80ffea", "white": "#f8f8f2", "brightBlack": "#504c67", "brightRed": "#ffaa99", "brightGreen": "#a2ff99", "brightYellow": "#ffff99", "brightBlue": "#aa99ff", "brightMagenta": "#ff99cc", "brightCyan": "#99ffee", "brightWhite": "#ffffff" }
